# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

# Required for Firebase – static frameworks
$RNFirebaseAsStaticFramework = true
use_frameworks! :linkage => :static

target 'GymlyFresh' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Xcode 26 / Apple Clang: fmt 11.0.2 consteval breaks. Compile fmt as C++17 only.
    installer.pods_project.targets.each do |target|
      next unless target.name == 'fmt'
      target.build_configurations.each do |cfg|
        cfg.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++17'
      end
    end
    %w[debug release].each do |config_name|
      xcconfig_path = File.join(__dir__, 'Pods', 'Target Support Files', 'fmt', "fmt.#{config_name}.xcconfig")
      next unless File.exist?(xcconfig_path)
      contents = File.read(xcconfig_path)
      patched = contents.gsub(/CLANG_CXX_LANGUAGE_STANDARD\s*=\s*c\+\+20/, 'CLANG_CXX_LANGUAGE_STANDARD = c++17')
      File.write(xcconfig_path, patched) if patched != contents
    end

    # use_frameworks! :static — React headers are not on disk until pod frameworks build.
    # Generate a flat <React/*.h> shim so GymlyFresh compiles on clean DerivedData.
    shim_script = File.join(__dir__, 'scripts', 'generate-react-header-shim.sh')
    system('bash', shim_script) || raise('generate-react-header-shim.sh failed')

    shim_path = File.join(__dir__, '.react-header-shim')
    installer.aggregate_targets.each do |aggregate_target|
      aggregate_target.user_project.native_targets.each do |target|
        next unless target.name == 'GymlyFresh'

        target.build_configurations.each do |cfg|
          paths = cfg.build_settings['HEADER_SEARCH_PATHS'] || '$(inherited)'
          paths = [paths] if paths.is_a?(String)
          extra = [
            "\"#{shim_path}\"",
            "\"#{File.join(config[:reactNativePath], 'React', 'Base')}\"",
            "\"#{File.join(config[:reactNativePath], 'React', 'DevSupport')}\"",
            "\"#{File.join(config[:reactNativePath], 'Libraries', 'AppDelegate')}\"",
          ]
          extra.each do |p|
            paths << p unless paths.include?(p)
          end
          cfg.build_settings['HEADER_SEARCH_PATHS'] = paths
        end
      end
      aggregate_target.user_project.save
    end
  end
end

