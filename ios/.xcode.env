# Try to find node in common locations
if command -v node > /dev/null 2>&1; then
  export NODE_BINARY=$(command -v node)
elif [ -f "$HOME/.local/bin/node" ]; then
  export NODE_BINARY="$HOME/.local/bin/node"
elif [ -f "/usr/local/bin/node" ]; then
  export NODE_BINARY="/usr/local/bin/node"
else
  export NODE_BINARY=$(which node || echo "")
fi

# react-native-config: when ENVFILE is unset, the repo-root `.env` (production) is used.
# Never commit an ENVFILE override for Release archives.
# For Debug QA only, export ENVFILE=.env.qa.local in that shell session.
