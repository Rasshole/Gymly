# Copy to `keystore.properties` (gitignored) before Play Store release builds.
#
# Generate a release keystore:
#   keytool -genkeypair -v -storetype PKCS12 -keystore gymly-release.keystore \
#     -alias gymly -keyalg RSA -keysize 2048 -validity 10000
#
# Then register the upload key in Google Play Console and update
# https://gymlyapp.com/.well-known/assetlinks.json with the release SHA-256.

storeFile=gymly-release.keystore
storePassword=REPLACE
keyAlias=gymly
keyPassword=REPLACE
