# Copy to `keystore.properties` (gitignored) before an Android release build.
# A release build fails if this file, its values, or the keystore file is missing.
# It is never signed with the debug key.
#
# Generate a release keystore:
#   keytool -genkeypair -v -storetype PKCS12 -keystore gymly-release.keystore \
#     -alias gymly -keyalg RSA -keysize 2048 -validity 10000
#
# The public assetlinks file is for the Play-distributed app. Its fingerprint
# must be the Play App Signing certificate from Play Console. That value is
# still unverified. Do not put the upload-key fingerprint in that file.

storeFile=gymly-release.keystore
storePassword=REPLACE
keyAlias=gymly
keyPassword=REPLACE
