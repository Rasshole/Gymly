# Gymly Shop — Shopify Storefront (public token only)
# Copy to `.env` at the repo root and fill in your public Storefront token.
# Never commit real tokens. Never use Admin API or private Storefront tokens.

SHOPIFY_STORE_DOMAIN=f08uqq-vy.myshopify.com
SHOPIFY_STOREFRONT_PUBLIC_TOKEN=YOUR_PUBLIC_STOREFRONT_TOKEN_HERE
SHOPIFY_STOREFRONT_API_VERSION=2026-04

# Catalogue source:
# - shopify → live Storefront API (required for production)
# - local  → Phase 1A mocks (dev/test only; ignored in production builds)
SHOP_CATALOG_SOURCE=shopify
