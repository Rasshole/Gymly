u03b7\u03bd \u03c0\u03b9\u03bf \u03c9\u03c1\u03b1\u03b9\u03b1 \u03b5\u03ba\u03b4\u03bf\u03c7\u03b7 \u03c4\u03bf\u03c5 \u03c3\u03c9\u03bc\u03b1\u03c4\u03bf\u03c2 \u03c3\u03b1\u03c2, <\/span><span style=\"font-weight: 500; text-transform: uppercase; color: #ffffff;\">\u03bc\u03b5 DNA Test \u0394\u03b9\u03b1\u03c7\u03b5\u03b9\u03c1\u03b9\u03c3\u03b7\u03c2 \u0392\u03b1\u03c1\u03bf\u03c5\u03c2,<\/span><span style=\"font-weight: 300; text-transform: uppercase; color: #ffffff;\">\u00a0\u0393\u0399\u0391 \u03a0\u03a1\u03a9\u03a4\u0397 \u03a6\u039f\u03a1\u0391\u00a0<span style=\"text-transform: uppercase; color: #ffffff; font-weight: 500;\">\u03c3\u03c4\u03bf \u03b4\u03b9\u03ba\u03bf \u03c3\u03b1\u03c2 YAVA!<\/span><\/span><\/h3>\n<p>[\/vc_column_text][\/vc_column_inner][\/vc_row_inner][\/vc_column][\/vc_row][vc_row css_animation=\u00bb\u00bb row_type=\u00bbrow\u00bb use_row_as_full_screen_section=\u00bbno\u00bb type=\u00bbgrid\u00bb angled_section=\u00bbno\u00bb text_align=\u00bbleft\u00bb background_image_as_pattern=\u00bbwithout_pattern\u00bb row_negative_margin=\u00bbdisable_negative_margin\u00bb css=\u00bb.vc_custom_1570106819348{margin-top: 20px !important;}\u00bb el_class=\u00bbdna-text\u00bb][vc_column css=\u00bb.vc_custom_1566378921024{margin-top: 20px !important;padding-right: 10px !important;padding-left: 10px !important;}\u00bb][vc_column_text]\u03a4\u03b1 <strong>YAVA Fitness Centers<\/strong>, \u03c4\u03bf \u03bc\u03b5\u03b3\u03b1\u03bb\u03cd\u03c4\u03b5\u03c1\u03bf \u03ba\u03b1\u03b9 \u03c0\u03b9\u03bf \u03b1\u03be\u03b9\u03cc\u03c0\u03b9\u03c3\u03c4\u03bf \u03b4\u03af\u03ba\u03c4\u03c5\u03bf \u03b3\u03c5\u03bc\u03bd\u03b1\u03c3\u03c4\u03b7\u03c1\u03af\u03c9\u03bd \u03c3\u03c4\u03b7\u03bd \u0395\u03bb\u03bb\u03ac\u03b4\u03b1 \u03ba\u03b1\u03b9 \u03bf \u03cc\u03bc\u03b9\u03bb\u03bf\u03c2 <strong>GENOMED<\/strong> , \u03bc\u03b5 \u03b4\u03c1\u03b1\u03c3\u03c4\u03b7\u03c1\u03b9\u03cc\u03c4\u03b7\u03c4\u03b5\u03c2 \u03c3\u03c4\u03bf\u03bd \u03c4\u03bf\u03bc\u03ad\u03b1 \u03c4\u03c9\u03bd \u03b3\u03bf\u03bd\u03b9\u03b4\u03b9\u03b1\u03ba\u03ce\u03bd \u03b5\u03be\u03b5\u03c4\u03ac\u03c3\u03b5\u03c9\u03bd, \u03ad\u03c0\u03b5\u03b9\u03c4\u03b1 \u03b1\u03c0\u03cc \u03c4\u03b7 \u03c3\u03cd\u03bd\u03b1\u03c8\u03b7 \u03c3\u03c4\u03c1\u03b1\u03c4\u03b7\u03b3\u03b9\u03ba\u03ae\u03c2 \u03c3\u03c5\u03bd\u03b5\u03c1\u03b3\u03b1\u03c3\u03af\u03b1\u03c2 \u03c0\u03b1\u03c1\u03bf\u03c5\u03c3\u03b9\u03ac\u03b6\u03bf\u03c5\u03bd \u03b1\u03c0\u03cc \u03ba\u03bf\u03b9\u03bd\u03bf\u03cd \u03c4\u03bf \u03c0\u03c1\u03ce\u03c4\u03bf <strong>KEYONUS DNA<\/strong>\u00a0Test\u00a0\u03c0\u03b1\u03c7\u03c5\u03c3\u03b1\u03c1\u03ba\u03af\u03b1\u03c2 \u03ba\u03b1\u03b9 \u03b4\u03b9\u03b1\u03c7\u03b5\u03af\u03c1\u03b9\u03c3\u03b7\u03c2 \u03b2\u03ac\u03c1\u03bf\u03c5\u03c2.<\/p>\n<p>\u03a0\u03c1\u03cc\u03ba\u03b5\u03b9\u03c4\u03b1\u03b9 \u03bf\u03c5\u03c3\u03b9\u03b1\u03c3\u03c4\u03b9\u03ba\u03ac \u03b3\u03b9\u03b1 \u03c4\u03b7\u03bd \u03c0\u03b9\u03bf \u03b1\u03be\u03b9\u03cc\u03c0\u03b9\u03c3\u03c4\u03b7 \u03c0\u03c1\u03bf\u03c3\u03ad\u03b3\u03b3\u03b9\u03c3\u03b7 \u03c0\u03bf\u03c5 \u03c5\u03c0\u03ac\u03c1\u03c7\u03b5\u03b9 \u03c3\u03ae\u03bc\u03b5\u03c1\u03b1 &#8211; \u03cc\u03c3\u03bf\u03bd \u03b1\u03c6\u03bf\u03c1\u03ac \u03c3\u03c4\u03b7\u03bd \u03b1\u03c0\u03ce\u03bb\u03b5\u03b9\u03b1 \u03c3\u03c9\u03bc\u03b1\u03c4\u03b9\u03ba\u03bf\u03cd \u03b2\u03ac\u03c1\u03bf\u03c5\u03c2 &#8211; \u03b7 \u03bf\u03c0\u03bf\u03af\u03b1 \u03b5\u03c6\u03b1\u03c1\u03bc\u03cc\u03b6\u03b5\u03c4\u03b1\u03b9 \u03ae\u03b4\u03b7 \u03bc\u03b5 \u03b5\u03c0\u03b9\u03c4\u03c5\u03c7\u03af\u03b1 \u03c3\u03b5 \u03c0\u03bf\u03bb\u03bb\u03ad\u03c2 \u03c7\u03ce\u03c1\u03b5\u03c2 \u03ba\u03b1\u03b9 \u03b2\u03b1\u03c3\u03af\u03b6\u03b5\u03c4\u03b1\u03b9 \u03c3\u03c4\u03bf\u03bd \u03b3\u03bf\u03bd\u03b9\u03b4\u03b9\u03b1\u03ba\u03cc \u03ad\u03bb\u03b5\u03b3\u03c7\u03bf \u03ba\u03b1\u03b9 \u03c3\u03b5 \u03b5\u03be\u03b1\u03c4\u03bf\u03bc\u03b9\u03ba\u03b5\u03c5\u03bc\u03ad\u03bd\u03bf \u03b