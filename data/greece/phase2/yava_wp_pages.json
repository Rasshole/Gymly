le=\"color: #000000;\">\u03a4\u0391 YAVA FITNESS CENTERS<\/span><\/h4>\n<p>[\/vc_column_text][vc_column_text]\u03be\u03b5\u03ba\u03af\u03bd\u03b7\u03c3\u03b1\u03bd \u03c4\u03b7\u03bd \u03b4\u03c5\u03bd\u03b1\u03bc\u03b9\u03ba\u03ae \u03c4\u03bf\u03c5\u03c2 \u03c0\u03bf\u03c1\u03b5\u03af\u03b1 \u03c4\u03bf 2011 \u03ba\u03b1\u03b9 \u03b1\u03c0\u03bf\u03c4\u03b5\u03bb\u03bf\u03cd\u03bd \u03c4\u03bf \u03bc\u03b5\u03b3\u03b1\u03bb\u03cd\u03c4\u03b5\u03c1\u03bf \u03b4\u03af\u03ba\u03c4\u03c5\u03bf \u03b3\u03c5\u03bc\u03bd\u03b1\u03c3\u03c4\u03b7\u03c1\u03af\u03c9\u03bd \u03c3\u03c4\u03b7\u03bd \u0395\u03bb\u03bb\u03ac\u03b4\u03b1, \u03bc\u03b5 \u03c0\u03b1\u03c1\u03bf\u03c5\u03c3\u03af\u03b1 \u03c3\u03b5 \u0391\u03c4\u03c4\u03b9\u03ba\u03ae, \u0398\u03b5\u03c3\u03c3\u03b1\u03bb\u03bf\u03bd\u03af\u03ba\u03b7, \u039a\u03c1\u03ae\u03c4\u03b7, \u03a0\u03ac\u03c4\u03c1\u03b1, \u03ba\u03b1\u03b9 \u03a1\u03cc\u03b4\u03bf.<\/p>\n<div id=\"simple-translate\" class=\"simple-translate-system-theme\"><\/div>\n<p>[\/vc_column_text][vc_empty_space height=\u00bb25px\u00bb][vc_column_text]<\/p>\n<h4><span style=\"color: #000000;\">\u0397 \u03a0\u03a1\u039f\u03a4\u0399\u039c\u0397\u03a3\u0397<\/span><\/h4>\n<p>[\/vc_column_text][vc_column_text]\u03ba\u03b1\u03b9 \u03b7 \u03b5\u03bc\u03c0\u03b9\u03c3\u03c4\u03bf\u03c3\u03cd\u03bd\u03b7 \u03c0\u03bf\u03c5 \u03bc\u03b1\u03c2 \u03b4\u03b5\u03af\u03c7\u03bd\u03bf\u03c5\u03bd \u03c4\u03b1 \u03bc\u03ad\u03bb\u03b7 \u03bc\u03b1\u03c2, \u03c3\u03b5 \u03c3\u03c5\u03bd\u03b4\u03c5\u03b1\u03c3\u03bc\u03cc \u03bc\u03b5 \u03c4\u03b7\u03bd \u03c0\u03bb\u03ae\u03c1\u03b7 \u03b3\u03ba\u03ac\u03bc\u03b1 \u03c5\u03c0\u03b7\u03c1\u03b5\u03c3\u03b9\u03ce\u03bd \u03c0\u03bf\u03c5 \u03c0\u03b1\u03c1\u03ad\u03c7\u03bf\u03c5\u03bc\u03b5 \u03c3\u03b5 \u03b9\u03b4\u03b9\u03b1\u03af\u03c4\u03b5\u03c1\u03b1 \u03c0\u03c1\u03bf\u03bd\u03bf\u03bc\u03b9\u03b1\u03ba\u03ad\u03c2 \u03c4\u03b9\u03bc\u03ad\u03c2, \u03b5\u03be\u03b1\u03c3\u03c6\u03b1\u03bb\u03af\u03b6\u03bf\u03c5\u03bd \u03c4\u03b7 \u03c3\u03c5\u03bd\u03b5\u03c7\u03ae \u03b1\u03bd\u03ac\u03c0\u03c4\u03c5\u03be\u03b7 \u03c4\u03bf\u03c5 \u03b4\u03b9\u03ba\u03c4\u03cd\u03bf\u03c5 \u03bc\u03b1\u03c2 \u03ba\u03b1\u03b9 \u03bc\u03b1\u03c2 \u03b4\u03af\u03bd\u03bf\u03c5\u03bd \u03c4\u03b7 \u03b4\u03c5\u03bd\u03b1\u03c4\u03cc\u03c4\u03b7\u03c4\u03b1 \u03bd\u03b1 \u03c5\u03c0\u03b7\u03c1\u03b5\u03c4\u03ae\u03c3\u03bf\u03c5\u03bc\u03b5 <span style=\"color: #000000;\"><strong>\u03c4\u03bf \u03cc\u03c1\u03b1\u03bc\u03ac \u03bc\u03b1\u03c2:<\/strong><\/span> <span style=\"color: #000000;\"><strong>\u039d\u03b1 \u03ba\u03ac\u03bd\u03bf\u03c5\u03bc\u03b5 \u03c4\u03bf fitness \u03c4\u03c1\u03cc\u03c0\u03bf \u03b6\u03c9\u03ae\u03c2 \u03b3\u03b9\u03b1 \u03cc\u03bb\u03bf\u03c5\u03c2 \u03ba\u03b1\u03b9 \u03c4\u03b1 Yava Fitness Centers \u03c3\u03c5\u03bd\u03ce\u03bd\u03c5\u03bc\u03bf \u03c4\u03bf\u03c5 \u03c0\u03bf\u03b9\u03bf\u03c4\u03b9\u03ba\u03bf\u03cd, \u03c0\u03c1\u03c9\u03c4\u03bf\u03c0\u03bf\u03c1\u03b9\u03b1\u03ba\u03bf\u03cd \u03ba\u03b1\u03b9 \u03c0\u03c1\u03bf\u03c3\u03b9\u03c4\u03bf\u03cd fitness.<\/strong><\/span>[\/vc_column_text][vc_empty_space height=\u00bb25px\u00bb][vc_column_text]<\/p>\n<h4>\u0397 \u0394\u0399\u0391\u03a6\u039f\u03a1\u0391<\/h4>\n<p>[\/vc_column_text][vc_column_text]\u03c4\u03c9\u03bd Yava \u03b5\u03af\u03bd\u03b1\u03b9 \u03b7 \u03c0\u03c1\u03bf\u03c3\u03ae\u03bb\u03c9\u03c3\u03b7 \u03c3\u03b5 \u03bf\u03c0\u03bf\u03b9\u03b1\u03b4\u03ae\u03c0\u03bf\u03c4\u03b5 \u03ba\u03b1\u03b9\u03bd\u03bf\u03c4\u03bf\u03bc\u03af\u03b1 \u03c3\u03c4\u03bf\u03bd \u03c7\u03ce\u03c1\u03bf \u03c4\u03bf\u03c5 fitness \u03ba\u03b1\u03b9 \u03b7 \u03b1\u03bd\u03c4\u03b1\u03c0\u03cc\u03ba\u03c1\u03b9\u03c3\u03b7 \u03c3\u03c4\u03b9\u03c2 \u03b1\u03c0\u03b1\u03b9\u03c4\u03ae\u03c3\u03b5\u03b9\u03c2 \u03c4\u03c9\u03bd \u03b1\u03bd\u03b8\u03c1\u03ce\u03c0\u03c9\u03bd \u03c0\u03bf\u03c5 \u03bc\u03b1\u03c2 \u03b5\u03c0\u03b9\u03bb\u03ad\u03b3\u03bf\u03c5\u03bd. \u0395\u03c0\u03b5\u03bd\u03b4\u03cd\u03bf\u03c5\u03bc\u03b5 \u03b4\u03b9\u03b1\u03c1\u03ba\u03ce\u03c2 \u03c3\u03b5 \u03bd\u03ad\u03b5\u03c2 \u03c0\u03c1\u03c9\u03c4\u03bf\u03c0\u03bf\u03c1\u03b9\u03b1\u03ba\u03ad\u03c2 \u03bc\u03b5\u03b8\u03cc\u03b4\u03bf\u03c5\u03c2 \u03b5\u03ba\u03b3\u03cd\u03bc\u03bd\u03b1\u03c3\u03b7\u03c2 \u03ba\u03b1\u03b9 \u03b5\u03bc\u03c0\u03bb\u03bf\u03c5\u03c4\u03af\u03b6\u03bf\u03c5\u03bc\u03b5 \u03c4\u03b9\u03c2 \u03b4\u03c1\u03b1\u03c3\u03c4\u03b7\u03c1\u03b9\u03cc\u03c4\u03b7\u03c4\u03b5\u03c2 \u03bc\u03b1\u03c2 \u03b5\u03bd\u03c4\u03ac\u03c3\u03c3\u03bf\u03bd\u03c4\u03b1\u03c2 \u03ac\u03bc\u03b5\u03c3\u03b1 \u03c3\u03b5 \u03b1\u03c5\u03c4\u03ad\u03c2 \u03ba\u03ac\u03b8\u03b5 \u03ba\u03b1\u03b9\u03bd\u03bf\u03c4\u03bf\u03bc\u03af\u03b1.<\/p>\n<p>\u03a4\u03bf \u03b1\u03bd\u03b8\u03c1\u03ce\u03c0\u03b9\u03bd\u03bf \u03b4\u03c5\u03bd\u03b1\u03bc\u03b9\u03ba\u03cc \u03c4\u03c9\u03bd Yava \u03b5\u03c0\u03b9\u03bb\u03ad\u03b3\u03b5\u03c4\u03b1\u03b9 \u03bc\u03b5 \u03b1\u03c5\u03c3\u03c4\u03b7\u03c1\u03ad\u03c2 \u03b4\u03b9\u03b1\u03b4\u03b9\u03ba\u03b1\u03c3\u03af\u03b5\u03c2. \u0391\u03c0\u03b1\u03c1\u03c4\u03af\u03b6\u03b5\u03c4\u03b1\u03b9 \u03b1\u03c0\u03cc \u03b1\u03bd\u03b1\u03b3\u03bd\u03c9\u03c1\u03b9\u03c3\u03bc\u03ad\u03bd\u03bf\u03c5\u03c2 \u03b3\u03c5\u03bc\u03bd\u03b1\u03c3\u03c4\u03ad\u03c2 \u03ba\u03b1\u03b9 \u03b1\u03b8\u03bb\u03b7\u03c4\u03ad\u03c2, \u03bc\u03b5 \u03c5\u03c8\u03b7\u03bb\u03ae \u03ba\u03b1\u03c4\u03ac\u03c1\u03c4\u03b9\u03c3\u03b7 \u03ba\u03b1\u03b9 \u03c0\u03ac\u03b8\u03bf\u03c2 \u03b3\u03b9\u03b1 \u03c4\u03bf fitness, \u03c0\u03bf\u03c5 \u03c0\u03b1\u03c1\u03b1\u03ba\u03bf\u03bb\u03bf\u03c5\u03b8\u03bf\u03cd\u03bd \u03b1\u03b4\u03b9\u03ac\u03bb\u03b5\u03b9\u03c0\u03c4\u03b1 \u03c4\u03b9\u03c2 \u03c0\u03b1\u03b3\u03ba\u03cc\u03c3\u03bc\u03b9\u03b5\u03c2 \u03b5\u03be\u03b5\u03bb\u03af\u03be\u03b5\u03b9\u03c2 \u03c3\u03c4\u03bf\u03bd \u03c7\u03ce\u03c1\u03bf.<\/p>\n<p>\u03a0\u03c1\u03bf\u03c4\u03b5\u03c1\u03b1\u03b9\u03cc\u03c4\u03b7\u03c4\u03b1 \u03b1\u03c0\u03bf\u03c4\u03b5\u03bb\u03b5\u03af \u03b3\u03b9\u03b1 \u03b5\u03bc\u03ac\u03c2 \u03ba\u03b1\u03b9 \u03b7 \u03c0\u03c1\u03bf\u03c3\u03c9\u03c0\u03b9\u03ba\u03ae \u03b5\u03c0\u03b1\u03c6\u03ae \u03bc\u03b5 \u03c4\u03bf\u03bd \u03c0\u03b5\u03bb\u03ac\u03c4\u03b7. \u0391\u03bd \u03ba\u03b1\u03b9 \u03c4\u03bf \u03b4\u03af\u03ba\u03c4\u03c5\u03bf \u03b1\u03bd\u03b1\u03c0\u03c4\u03cd\u03c3\u03c3\u03b5\u03c4\u03b1\u03b9 \u03b4\u03b9\u03b1\u03c1\u03ba\u03ce\u03c2 \u03c0\u03c1\u03bf\u03c4\u03b5\u03c1\u03b1\u03b9\u03cc\u03c4\u03b7\u03c4\u03ac \u03bc\u03b1\u03c2 \u03b5\u03af\u03bd\u03b1\u03b9 \u03bd\u03b1 \u03bd\u03b9\u03ce\u03b8\u03b5\u03b9 \u03ba\u03b1\u03b9 \u03bd\u03b1 \u03b5\u03af\u03bd\u03b1\u03b9 \u03bf \u03ba\u03ac\u03b8\u03b5 \u03c0\u03b5\u03bb\u03ac\u03c4\u03b7\u03c2 \u03bc\u03bf\u03bd\u03b1\u03b4\u03b9\u03ba\u03cc\u03c2.[\/vc_column_text][vc_empty_space height=\u00bb25px\u00bb][vc_column_text]<\/p>\n<h4>\u0395\u03a4\u0391\u0399\u03a1\u0399\u039a\u0397 \u039a\u039f\u0399\u039d\u03a9\u039d\u0399\u039a\u0397 \u0395\u03a5\u0398\u03a5\u039d\u0397<\/h4>\n<p>[\/vc_column_text][vc_column_text]\u0397 \u03b5\u03c4\u03b1\u03b9\u03c1\u03b9\u03ba\u03ae \u03c5\u03c0\u03b5\u03c5\u03b8\u03c5\u03bd\u03cc\u03c4\u03b7\u03c4\u03b1 \u03b1\u03c0\u03bf\u03c4\u03b5\u03bb\u03b5\u03af \u03b2\u03b1\u03c3\u03b9\u03ba\u03cc \u03c0\u03c5\u03bb\u03ce\u03bd\u03b1 \u03c4\u03b7\u03c2 \u03c3\u03c4\u03c1\u03b1\u03c4\u03b7\u03b3\u03b9\u03ba\u03ae\u03c2 \u03c4\u03bf\u03c5 \u03bf\u03bc\u03af\u03bb\u03bf\u03c5 \u03a5ava Fitness Centers \u03ba\u03b1\u03b9 \u03ad\u03c7\u03b5\u03b9 \u03b5\u03bd\u03c3\u03c9\u03bc\u03b1\u03c4\u03c9\u03b8\u03b5\u03af \u03ad\u03bc\u03c0\u03c1\u03b1\u03ba\u03c4\u03b1 \u03c3\u03c4\u03b7\u03bd \u03b5\u03c0\u03b9\u03c7\u03b5\u03b9\u03c1\u03b7\u03c3\u03b9\u03b1\u03ba\u03ae \u03bc\u03b1\u03c2 \u03bb\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03af\u03b1.<\/p>\n<p>\u039f\u03b9 \u03ba\u03bf\u03b9\u03bd\u03c9\u03bd\u03b9\u03ba\u03ad\u03c2 \u03b4\u03c1\u03ac\u03c3\u03b5\u03b9\u03c2 \u03c4\u03bf\u03c5 \u03bf\u03bc\u03af\u03bb\u03bf\u03c5 \u03b3\u03af\u03bd\u03bf\u03bd\u03c4\u03b1\u03b9 \u03bc\u03b5 \u03bf\u03c1\u03b3\u03ac\u03bd\u03c9\u03c3\u03b7, \u03bc\u03b5\u03b8\u03bf\u03b4\u03b9\u03ba\u03cc\u03c4\u03b7\u03c4\u03b1 \u03ba\u03b1\u03b9 \u03c0\u03c1\u03bf\u03b3\u03c1\u03b1\u03bc\u03bc\u03b1\u03c4\u03b9\u03c3\u03bc\u03cc \u03bc\u03b5 \u03c3\u03ba\u03bf\u03c0\u03cc \u03bd\u03b1 \u03b5\u03c0\u03b9\u03c6\u03ad\u03c1\u03bf\u03c5\u03bd \u03c0\u03ac\u03bd\u03c4\u03b1 \u03b5\u03c5\u03bd\u03bf\u03ca\u03ba\u03ac \u03b1\u03c0\u03bf\u03c4\u03b5\u03bb\u03ad\u03c3\u03bc\u03b1\u03c4\u03b1.<\/p>\n<p>\u0394\u03af\u03bd\u03bf\u03c5\u03bc\u03b5 \u03ad\u03bc\u03c6\u03b1\u03c3\u03b7 \u03c3\u03c4\u03b7\u03bd \u03ba\u03b1\u03c4\u03b1\u03c0\u03bf\u03bb\u03ad\u03bc\u03b7\u03c3\u03b7 \u03c4\u03c9\u03bd \u03ba\u03bf\u03b9\u03bd\u03c9\u03bd\u03b9\u03ba\u03ce\u03bd \u03b1\u03c0\u03bf\u03ba\u03bb\u03b5\u03b9\u03c3\u03bc\u03ce\u03bd, \u03c3\u03c4\u03b7\u03bd \u03b5\u03bd\u03af\u03c3\u03c7\u03c5\u03c3\u03b7 \u03c4\u03c9\u03bd \u03b5\u03c5\u03c0\u03b1\u03b8\u03ce\u03bd \u03ba\u03bf\u03b9\u03bd\u03c9\u03bd\u03b9\u03ba\u03ce\u03bd \u03bf\u03bc\u03ac\u03b4\u03c9\u03bd \u03b5\u03bd\u03ce \u03b5\u03c0\u03b9\u03ba\u03b5\u03bd\u03c4\u03c1\u03ce\u03bd\u03bf\u03c5\u03bc\u03b5 \u03c4\u03bf \u03b5\u03bd\u03b4\u03b9\u03b1\u03c6\u03ad\u03c1\u03bf\u03bd \u03bc\u03b1\u03c2 \u03ba\u03b1\u03b9 \u03c3\u03b5 \u03c4\u03bf\u03bc\u03b5\u03af\u03c2 \u03cc\u03c0\u03c9\u03c2 \u03c3\u03c4\u03b7\u03bd \u03c0\u03c1\u03bf\u03c3\u03c4\u03b1\u03c3\u03af\u03b1 \u03c4\u03bf\u03c5 \u03c0\u03b5\u03c1\u03b9\u03b2\u03ac\u03bb\u03bb\u03bf\u03bd\u03c4\u03bf\u03c2 \u03b1\u03bb\u03bb\u03ac \u03ba\u03b1\u03b9 \u03c4\u03b7\u03c2 \u03c5\u03b3\u03b5\u03af\u03b1\u03c2- \u03b5\u03c5\u03b5\u03be\u03af\u03b1\u03c2.<\/p>\n<p>\u03a0\u03b1\u03c1\u03ac\u03bb\u03bb\u03b7\u03bb\u03b1 \u03b1\u03bd\u03b1\u03c0\u03c4\u03cd\u03c3\u03c3\u03bf\u03c5\u03bc\u03b5 \u03c3\u03c5\u03bd\u03b5\u03c7\u03ce\u03c2 \u03bd\u03a