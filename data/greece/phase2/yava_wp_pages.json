c2 \u03b3\u03bd\u03c9\u03c3\u03c4\u03ae \u03c3\u03c4\u03bf\u03bd \u03b9\u03b1\u03c4\u03c1\u03b9\u03ba\u03cc \u03ba\u03cc\u03c3\u03bc\u03bf \u03ba\u03b1\u03b9 \u03ba\u03c5\u03c1\u03af\u03c9\u03c2 \u03c3\u03c4\u03bf\u03bd \u03c6\u03c5\u03c3\u03b9\u03ba\u03bf\u03b8\u03b5\u03c1\u03b1\u03c0\u03b5\u03c5\u03c4\u03b9\u03ba\u03cc \u03c7\u03ce\u03c1\u03bf \u03c9\u03c2 \u03bc\u03ad\u03c3\u03bf \u03ac\u03bc\u03b5\u03c3\u03b7\u03c2 \u03b5\u03bd\u03b4\u03c5\u03bd\u03ac\u03bc\u03c9\u03c3\u03b7\u03c2.<\/p>\n<p>\u03a4\u03bf\u00a0<strong>Miha Bodytech \u0399\u0399<\/strong> \u03b5\u03af\u03bd\u03b1\u03b9 \u03c4\u03bf \u03bc\u03bf\u03bd\u03b1\u03b4\u03b9\u03ba\u03cc <strong>EMS<\/strong> \u03bc\u03b7\u03c7\u03ac\u03bd\u03b7\u03bc\u03b1 100% \u03c3\u03c5\u03bc\u03b2\u03b1\u03c4\u03cc \u03bc\u03b5 \u03c4\u03bf\u03bd \u03bd\u03ad\u03bf \u03b5\u03c5\u03c1\u03c9\u03c0\u03b1\u03ca\u03ba\u03cc \u03ba\u03b1\u03bd\u03bf\u03bd\u03b9\u03c3\u03bc\u03cc \u03b3\u03b9\u03b1 \u03cc\u03bb\u03b1 \u03c4\u03b1 \u03bc\u03b7\u03c7\u03b1\u03bd\u03ae\u03bc\u03b1\u03c4\u03b1 \u03b7\u03bb\u03b5\u03ba\u03c4\u03c1\u03bf\u03bc\u03c5\u03bf\u03b4\u03b9\u03b5\u03b3\u03b5\u03c1\u03c3\u03b7\u03c2, \u03b5\u03bd\u03ce \u03ad\u03c7\u03b5\u03b9 \u03c0\u03ac\u03c1\u03b5\u03b9 \u03ad\u03b3\u03ba\u03c1\u03b9\u03c3\u03b7 \u03b1\u03c0\u03cc \u03c4\u03bf\u03bd \u0395.\u039f.\u03a6 \u03c9\u03c2 \u03b9\u03b1\u03c4\u03c1\u03b9\u03ba\u03cc \u03bc\u03b7\u03c7\u03ac\u03bd\u03b7\u03bc\u03b1.<\/p>\n<p>\u039c\u03b9\u03b1 \u03c3\u03c5\u03bd\u03b5\u03b4\u03c1\u03af\u03b1 \u03b5\u03ba\u03b3\u03cd\u03bc\u03bd\u03b1\u03c3\u03b7\u03c2 \u03b4\u03b9\u03b1\u03c1\u03ba\u03b5\u03af \u03ba\u03ac\u03b8\u03b5 \u03c6\u03bf\u03c1\u03ac \u03bc\u03cc\u03bd\u03bf 20 \u03bb\u03b5\u03c0\u03c4\u03ac \u03ba\u03b1\u03b9 \u03c0\u03c1\u03b1\u03b3\u03bc\u03b1\u03c4\u03bf\u03c0\u03bf\u03b9\u03b5\u03af\u03c4\u03b1\u03b9 \u03bc\u03b5 \u03b5\u03be\u03b5\u03b9\u03b4\u03b9\u03ba\u03b5\u03c5\u03bc\u03ad\u03bd\u03bf \u03b5\u03ba\u03c0\u03b1\u03b9\u03b4\u03b5\u03c5\u03c4\u03ae.<\/p>\n<p>\u039c\u03b9\u03b1 \u03c6\u03bf\u03c1\u03ac \u03c4\u03b7\u03bd \u03b5\u03b2\u03b4\u03bf\u03bc\u03ac\u03b4\u03b1 \u03b1\u03c1\u03ba\u03b5\u03af \u03b3\u03b9\u03b1 \u03c4\u03b7\u03bd \u03b1\u03be\u03b9\u03cc\u03c0\u03b9\u03c3\u03c4\u03b7 \u03b5\u03c0\u03af\u03c4\u03b5\u03c5\u03be\u03b7 \u03c4\u03c9\u03bd \u03bc\u03b5\u03bc\u03bf\u03bd\u03c9\u03bc\u03ad\u03bd\u03c9\u03bd \u03c3\u03c4\u03cc\u03c7\u03c9\u03bd \u03b5\u03be\u03b1\u03c3\u03c6\u03b1\u03bb\u03af\u03b6\u03bf\u03bd\u03c4\u03b1\u03c2 \u03c3\u03c4\u03bf\u03bd \u03b1\u03c3\u03ba\u03bf\u03cd\u03bc\u03b5\u03bd\u03bf \u03bf\u03bb\u03bf\u03ba\u03bb\u03b7\u03c1\u03c9\u03bc\u03ad\u03bd\u03b5\u03c2 \u03c0\u03c1\u03bf\u03c0\u03bf\u03bd\u03ae\u03c3\u03b5\u03b9\u03c2 \u03ba\u03b1\u03b8\u03ce\u03c2 \u03b3\u03c5\u03bc\u03bd\u03ac\u03b6\u03b5\u03b9 \u03c4\u03b1\u03c5\u03c4\u03cc\u03c7\u03c1\u03bf\u03bd\u03b1 \u03c0\u03cc\u03b4\u03b9\u03b1, \u03c7\u03ad\u03c1\u03b9\u03b1, \u03c0\u03bb\u03ac\u03c4\u03b7 \u03ba\u03b1\u03b9 \u03ba\u03bf\u03b9\u03bb\u03b9\u03ac.<\/p>\n<p>\u2714 \u0392\u03b5\u03bb\u03c4\u03af\u03c9\u03c3\u03b7 \u03c6\u03c5\u03c3\u03b9\u03ba\u03ae\u03c2 \u03ba\u03b1\u03c4\u03ac\u03c3\u03c4\u03b1\u03c3\u03b7\u03c2<br \/>\n\u2714 \u0391\u03c0\u03ce\u03bb\u03b5\u03b9\u03b1 \u03b2\u03ac\u03c1\u03bf\u03c5\u03c2\/ \u03bb\u03af\u03c0\u03bf\u03c5\u03c2<br \/>\n\u2714 \u0393\u03c1\u03ac\u03bc\u03bc\u03c9\u03c3\u03b7<br \/>\n\u2714 \u0391\u03cd\u03be\u03b7\u03c3\u03b7 \u03bc\u03c5\u03b9\u03ba\u03ae\u03c2 \u03bc\u03ac\u03b6\u03b1\u03c2\/ \u03b4\u03cd\u03bd\u03b1\u03bc\u03b7\u03c2<br \/>\n\u2714 \u0392\u03b5\u03bb\u03c4\u03af\u03c9\u03c3\u03b7 \u03ba\u03c5\u03ba\u03bb\u03bf\u03c6\u03bf\u03c1\u03b9\u03ba\u03bf\u03cd<br \/>\n\u2714 \u0391\u03c0\u03bf\u03ba\u03b1\u03c4\u03ac\u03c3\u03c4\u03b1\u03c3\u03b7 \u03bc\u03b5\u03c4\u03ac \u03b1\u03c0\u03cc \u03b5\u03c0\u03ad\u03bc\u03b2\u03b1\u03c3\u03b7<br \/>\n\u2714 \u03a0\u03b5\u03c1\u03b9\u03bf\u03c1\u03b9\u03c3\u03bc\u03cc\u03c2 \u03c0\u03cc\u03bd\u03c9\u03bd \u03c3\u03c4\u03b7 \u03bc\u03ad\u03c3\u03b7 \/ \u03c0\u03bb\u03ac\u03c4\u03b7<br \/>\n\u2714 \u0394\u03b9\u03b1\u03c7\u03b5\u03af\u03c1\u03b9\u03c3\u03b7 \u03c0\u03c1\u03bf\u03b2\u03bb\u03b7\u03bc\u03ac\u03c4\u03c9\u03bd \u03c3\u03b5 \u03b7\u03bb\u03b9\u03ba\u03b9\u03c9\u03bc\u03ad\u03bd\u03bf\u03c5\u03c2<br \/>\n\u2714 \u0395\u03bd\u03b5\u03c1\u03b3\u03bf\u03c0\u03bf\u03af\u03b7\u03c3\u03b7 \u03bc\u03b5\u03c4\u03b1\u03b2\u03bf\u03bb\u03b9\u03c3\u03bc\u03bf\u03cd<br \/>\n\u2714 \u039c\u03c5\u03ca\u03ba\u03ae \u03b5\u03bd\u03b4\u03c5\u03bd\u03ac\u03bc\u03c9\u03c3\u03b7<br \/>\n\u2714 \u03a0\u03c1\u03bf\u03c0\u03cc\u03bd\u03b7\u03c3\u03b7 \u03c5\u03c8\u03b7\u03bb\u03ce\u03bd \u03b5\u03c0\u03b9\u03b4\u03cc\u03c3\u03b5\u03c9\u03bd<br \/>\n\u2714 \u039c\u03b5\u03af\u03c9\u03c3\u03b7 \u03ba\u03c5\u03c4\u03c4\u03b1\u03c1\u03af\u03c4\u03b9\u03b4\u03b1\u03c2 \u03ba\u03b1\u03b9 \u03c7\u03b1\u03bb\u03ac\u03c1\u03c9\u03c3\u03b7\u03c2<br \/>\n\u2714 \u03a0\u03bd\u03b5\u03c5\u03bc\u03b1\u03c4\u03b9\u03ba\u03ae \u03ba\u03b1\u03b9 \u03c8\u03c5\u03c7\u03b9\u03ba\u03ae \u03b5\u03c5\u03b5\u03be\u03af\u03b1<br \/>\n\u2714 \u0392\u03b5\u03bb\u03c4\u03af\u03c9\u03c3\u03b7 \u03ba\u03b9\u03bd\u03b7\u03c4\u03b9\u03ba\u03cc\u03c4\u03b7\u03c4\u03b1\u03c2\/ \u03b5\u03bb\u03b1\u03c3\u03c4\u03b9\u03ba\u03cc\u03c4\u03b7\u03c4\u03b1\u03c2<br \/>\n\u2714 \u03a1\u03cd\u03b8\u03bc\u03b9\u03c3\u03b7 \u03b1\u03ba\u03c1\u03ac\u03c4\u03b5\u03b9\u03b1\u03c2<\/p>\n<p>\u0392\u03c1\u03b5\u03c2 \u03c4\u03b7\u03bd \u03b5\u03c0\u03b1\u03bd\u03b1\u03c3\u03c4\u03b1\u03c4\u03b9\u03ba\u03ae \u03bc\u03ad\u03b8\u03bf\u03b4\u03bf \u03b5\u03ba\u03b3\u03cd\u03bc\u03bd\u03b1\u03c3\u03b7\u03c2 \u03bc\u03b5 \u03c4\u03bf \u03bc\u03bf\u03bd\u03b1\u03b4\u03b9\u03ba\u03cc <strong>Miha Bodytec II<\/strong>, \u03c3\u03c4\u03b1 Yava \u03a7\u03b1\u03bb\u03b1\u03bd\u03b4\u03c1\u03af\u03bf\u03c5 \u03ba\u03b1\u03b9 \u039d. \u03a6\u03b9\u03bb\u03b1\u03b4\u03ad\u03bb\u03c6\u03b5\u03b9\u03b1\u03c2![\/vc_column_text][\/vc_column][\/vc_row][vc_row